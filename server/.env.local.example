# Modo local do evento (npm run local / iniciar-local.bat).
# Copie para server/.env.local e preencha. O banco e o segredo dos logins são criados sozinhos em EAG/.dados-local/.

# Administrador criado na primeira vez que o sistema local sobe (login em #/admin).
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chave PIX fixa (a mesma do QR Code do balcão). Também dá para preencher depois em Configurações → PIX.
PAYMENT_PIX_KEY=
PAYMENT_PIX_TYPE=Aleatória
PAYMENT_BENEFICIARY=EAG - Graças
PAYMENT_CITY=GRAÇAS

APP_TIMEZONE=America/Fortaleza
# Porta das telas e da API (os outros aparelhos abrem http://<ip-deste-notebook>:3001).
PORT=3001

# Endereço do sistema na nuvem, usado por "npm run importar" para trazer o cardápio.
CLOUD_URL=https://eag-final.vercel.app
