# Copie para server/.env e preencha. A API lê o .env da pasta server/.

# Banco PostgreSQL. Na Vercel, as duas URLs vêm da integração com o Neon.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/eag
# Conexão direta (sem pooler), usada só nas migrações. Opcional fora do Neon.
DATABASE_URL_UNPOOLED=

# Segredo dos logins do painel: 32 caracteres ou mais.
JWT_SECRET=

# Administrador criado na primeira inicialização (login em #/admin).
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Endereço do site que pode chamar a API (vários separados por vírgula).
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
APP_TIMEZONE=America/Fortaleza

# PIX com chave fixa e conferência manual (usado quando o Mercado Pago não está configurado).
PAYMENT_PIX_KEY=
PAYMENT_PIX_TYPE=Aleatória
PAYMENT_BENEFICIARY=EAG - Graças
PAYMENT_CITY=GRAÇAS
PAYMENT_DEADLINE_MINUTES=15

# PIX automático pelo Mercado Pago (aplicação "Checkout Transparente", API de Payments).
# Access Token: TEST-... para testes, APP_USR-... em produção. A conta precisa ter uma chave PIX cadastrada.
MP_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (painel do Mercado Pago > Webhooks).
MP_WEBHOOK_SECRET=
# E-mail enviado como pagador; precisa ser diferente do e-mail da conta do Mercado Pago.
MP_PAYER_EMAIL=
# Endereço público do site, para o webhook. Na Vercel, o domínio de produção é usado sozinho.
PUBLIC_URL=
